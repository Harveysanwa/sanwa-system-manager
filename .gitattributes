# 统一换行符，避免 Windows 下 Git 反复提示 LF/CRLF
* text=auto

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf

# 代码与文档使用 LF
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制（本项目一般没有）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
