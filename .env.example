# Sanwa系统管理器 环境变量示例（复制/设置后重启服务）
# 应用根目录（默认=server.js 所在目录）
SANWA_HOME=
# 服务端口（默认 9900）
SANWA_PORT=9900
# 数据目录 / 日志目录（默认 <SANWA_HOME>\data、<SANWA_HOME>\logs）
SANWA_DATA_DIR=
SANWA_LOG_DIR=
# AI 根目录 / 模型目录（%SANWA_AI_ROOT% / %SANWA_MODELS_ROOT% 会被 install.ps1 展开）
SANWA_AI_ROOT=
SANWA_MODELS_ROOT=
# 可选第三方工具路径占位符（tools.json 中 %VAR%）
LMSTUDIO_HOME=
DSH_EXE=
DSH_HOME=
COMFYUI_HOME=
KIWIX_HOME=
PYTHON314_HOME=
VENDOR_AI_ADVISOR_HOME=
